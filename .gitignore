.playwright-mcp/
.claude/
.DS_Store

# The test harness lives next to the game but is not part of it — the game ships
# with no dependencies, no build step and nothing to install, and that stays true.
# See test/README.md.
test/*
# ...with one exception: the save-compatibility gate. It needs nothing but Node, the
# game never loads it, and every session has to be able to run it before a merge to
# master — which is a deploy (see CLAUDE.md, "Production").
!test/saves.js
!test/saves/
